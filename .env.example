# Parley daemon configuration — copy to .env (gitignored) and fill in.
# Secrets are read from the environment only; never commit real values.
GEMINI_API_KEY=<your-gemini-api-key>
TWILIO_ACCOUNT_SID=<your-twilio-account-sid>
TWILIO_AUTH_TOKEN=<your-twilio-auth-token>
TWILIO_FROM_NUMBER=+14155550001
PARLEY_PUBLIC_HOST=voice.example.com
# Required. POST /call rejects every request that does not present this as a
# bearer token, and the daemon refuses to start without it. Generate one with
# `openssl rand -hex 32`. `parley call` reads the same variable.
PARLEY_CALL_TOKEN=<a-long-random-string>
PARLEY_PORT=3334
# The daemon binds loopback unless you deliberately widen it. Put a tunnel or
# reverse proxy in front rather than binding 0.0.0.0.
PARLEY_BIND_HOST=127.0.0.1
PARLEY_CALLABLE_NUMBERS=+14155550002
PARLEY_DAEMON_URL=http://127.0.0.1:3334
