# Parley daemon configuration — copy to .env (gitignored) and fill in.
# Secrets are read from the environment only; never commit real values.
GEMINI_API_KEY=<your-gemini-api-key>
TWILIO_ACCOUNT_SID=<your-twilio-account-sid>
TWILIO_AUTH_TOKEN=<your-twilio-auth-token>
TWILIO_FROM_NUMBER=+14155550001
PARLEY_PUBLIC_HOST=voice.example.com
PARLEY_PORT=3334
PARLEY_CALLABLE_NUMBERS=+14155550002
PARLEY_DAEMON_URL=http://127.0.0.1:3334
