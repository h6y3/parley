  "cards": [
    {
      "dot": "cyan",
      "title": "Call setup",
      "items": [
        "Bearer token on POST /call, checked in constant time, fail closed",
        "CallSid correlates origination, answer webhook, and media WS",
        "Media attaches before realtime.connect() so the start frame lands"
      ]
    },
    {
      "dot": "emerald",
      "title": "Conversation loop",
      "items": [
        "Caller speech: 8 kHz μ-law → 16 kHz PCM → Gemini",
        "Model speech: 24 kHz PCM → ÷3 decimation → 8 kHz μ-law at a 20 ms pace",
        "press_digits sends in-band DTMF; barge-in clears buffer and carrier"
      ]
    },
    {
      "dot": "rose",
      "title": "Execution gate",
      "items": [
        "Model proposes, server disposes: every tool crosses ToolGate",
        "spendCeiling refuses over-limit records before anything is written",
        "Duration and silence caps end the call; ToolResult is a closed union"
      ]
    }
  ]
