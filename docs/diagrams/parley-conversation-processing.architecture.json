  "cards": [
    {
      "dot": "cyan",
      "title": "Call setup",
      "items": [
        "POST /call validates the destination against the callable-number allowlist, fail closed",
        "CallSid correlates origination, the answer webhook, and the media WS",
        "Media socket attaches before realtime.connect() so the start frame is never dropped"
      ]
    },
    {
      "dot": "emerald",
      "title": "Conversation loop",
      "items": [
        "Caller speech: 8 kHz μ-law → 16 kHz PCM → Gemini",
        "Model speech: 24 kHz PCM → ÷3 averaging decimation → 8 kHz μ-law",
        "Twilio drops faster-than-real-time audio, so a 20 ms frame pacer drains output"
      ]
    },
    {
      "dot": "rose",
      "title": "Guardrails",
      "items": [
        "Policy guardrails composed upstream of CallSession",
        "systemInstruction renders persona → rules → guardrails, exactly once",
        "Brief never re-enters the call as a conversational turn"
      ]
    }
  ]
